      <bt:LongStrings>
        <bt:String id="DGNL.Menu.Tip" DefaultValue="Công cụ cho đề ĐGNL ĐHQG-HCM: chuẩn hoá dòng dẫn Toán, đánh số câu, gạch chân đáp án Ngữ Văn, sửa ngắt dòng Tiếng Anh, xoá đáp án chi tiết."/>
        <bt:String id="ChuanHoaToan.Tip" DefaultValue="Dành cho: đề Toán ĐGNL có nhóm câu dùng chung dữ kiện. Viết lại dòng &quot;Dựa vào… câu X-Y&quot; theo mẫu chuẩn, đưa dữ kiện về lề 0, canh giữa hình/bảng. Cần: câu hỏi &quot;Câu N.&quot; đánh số tự động."/>
        <bt:String id="FixTabNumbering.Tip" DefaultValue="Dành cho: đề ghép từ nhiều nguồn, số câu bị nhảy hoặc lệch tab. Gộp các dòng &quot;Câu N.&quot; vào một danh sách, đánh số 1…N, thụt lề treo 1,75 cm. Cần: &quot;Câu N.&quot; là đánh số tự động, nằm ngoài bảng."/>
        <bt:String id="GachDapAnNguVan.Tip" DefaultValue="Dành cho: đề Ngữ Văn có &quot;Lời giải&quot; và dòng đáp án &quot;X.&quot; ngay bên dưới. Tô đỏ, gạch chân chữ cái đáp án đúng; xoá dòng đáp án và lời giải lặp lại đề. Có xoá nội dung — nên lưu bản sao."/>
        <bt:String id="RemoveBreakEng.Tip" DefaultValue="Dành cho: đề Tiếng Anh có khoảng trắng lớn giữa câu hỏi và đáp án. Tắt &quot;Keep with next&quot; ở lời giải, giải thích, bài đọc; câu hỏi vẫn đi cùng đáp án. Cần: phương án gõ dạng &quot;A.&quot; … &quot;D.&quot;."/>
        <bt:String id="XoaDactDgnl.Tip" DefaultValue="Dành cho: tạo bản đề cho học sinh. Xoá mọi khối từ dòng &quot;Lời giải&quot; đến trước câu kế tiếp (kể cả bảng, hình). Cần: câu hỏi thụt lề treo, dòng dẫn lề 0. Có xoá nội dung — nên lưu bản sao."/>
        <bt:String id="Author.Tip" DefaultValue="Tác giả, liên hệ, mã nguồn, giấy phép và danh sách công cụ của MY_SCRIPTS."/>
        <bt:String id="CheckUpdate.Tip" DefaultValue="So sánh phiên bản đang cài với bản mới nhất. Nếu có bản mới, mở trình cập nhật (sẽ hỏi trước khi cài và yêu cầu đóng Word)."/>
        <bt:String id="CTPT2018.Menu.Tip" DefaultValue="Công cụ cho đề theo cấu trúc GDPT 2018: PHẦN I trắc nghiệm, PHẦN II đúng/sai, PHẦN III trả lời ngắn, tự luận."/>
        <bt:String id="TaoBangDapAn.Tip" DefaultValue="Dành cho: đề GDPT 2018 chia PHẦN (trắc nghiệm, đúng/sai, trả lời ngắn, tự luận). Điền đáp án vào bảng; bảng thiếu tạo tại con trỏ. Cần: &quot;Câu N.&quot;, đáp án gạch chân/highlight, &quot;Chọn X&quot; hoặc &quot;Đáp án:&quot;."/>
        <bt:String id="Equations.Menu.Tip" DefaultValue="Chuyển công thức giữa LaTeX ($…$, $…$, \[…\]) và equation Word. Mỗi lệnh hỏi phạm vi: vùng chọn hoặc toàn bộ tài liệu."/>
        <bt:String id="LatexToEquation.Tip" DefaultValue="Dành cho: tài liệu có công thức LaTeX dạng $…$, $…$ hoặc \[…\]. Thay bằng equation Word (inline/display). Hỏi phạm vi: vùng chọn hoặc toàn bộ tài liệu. Cần: LaTeX hợp lệ."/>
        <bt:String id="EquationToLatex.Tip" DefaultValue="Dành cho: tài liệu có equation Word (OMML). Thay bằng LaTeX $…$ (inline) hoặc $…$ (display). Hỏi phạm vi: vùng chọn hoặc toàn bộ. Không hỗ trợ MathType; toàn tài liệu bỏ qua đoạn có hình/field."/>
        <bt:String id="BigKey.Menu.Tip" DefaultValue="Chuẩn hoá đề trắc nghiệm theo mẫu BigKey (dàn phương án 1/2/4 dòng, đánh số câu, lời giải) và kiểm tra lỗi đề. Bảng trong đề được giữ nguyên."/>
        <bt:String id="ChuanHoaBigKeyDe.Tip" DefaultValue="Dành cho: đề trắc nghiệm A–D &quot;Câu N.&quot;. Đổi số tự động thành chữ, TNR 12, dàn phương án theo độ rộng, đáp án đỏ gạch chân, highlight &quot;Chọn X&quot;. Giữ nguyên bảng. Cần: đáp án gạch chân hoặc &quot;Chọn X&quot;."/>
        <bt:String id="ChuanHoaBigKeyBoiDen.Tip" DefaultValue="Dành cho: một phần đề trắc nghiệm A–D. Như Chuẩn hoá BigKey nhưng chỉ xử lý các đoạn trong vùng bôi đen; không đổi khổ giấy. Cần: bôi đen trọn các câu cần chuẩn hoá."/>
        <bt:String id="CheckLoiDe.Tip" DefaultValue="Dành cho: đề trắc nghiệm trước khi chuẩn hoá. Liệt kê số câu trùng/nhảy, thiếu/trùng/sai thứ tự A–D, thiếu đáp án, gạch chân khác &quot;Chọn X&quot;, hình lạc; chọn sẵn câu lỗi đầu tiên. Không sửa đề."/>
        <bt:String id="Xoa.Menu.Tip" DefaultValue="Xoá nhanh phần không cần trong đề: trích nguồn, lời giải, tác giả; xoá câu theo mức độ, mã ID, thay lời giải bằng dòng chấm, tạo khung câu hỏi."/>
        <bt:String id="XoaTrichNguon.Tip" DefaultValue="Dành cho: đề có cụm [mã]/(nguồn) ngay sau &quot;Câu N.&quot;. Xoá các cụm đó ở đầu mỗi câu. Cần: câu hỏi &quot;Câu N.&quot; (gõ tay hoặc tự động)."/>
        <bt:String id="XoaLoiGiai.Tip" DefaultValue="Dành cho: tạo đề cho học sinh. Xoá từ &quot;Lời giải&quot;/&quot;Hướng dẫn giải&quot; đến trước câu kế tiếp (kể cả bảng, hình), giữ lời dẫn nhóm câu và bài đọc. Có xoá nội dung — nên lưu bản sao."/>
        <bt:String id="XoaTacGia.Tip" DefaultValue="Dành cho: đề tổng hợp có ghi tác giả. Xoá dòng bắt đầu bằng &quot;Tác giả&quot; và cụm [(Tác giả …)] trong câu. Có xoá nội dung — nên lưu bản sao."/>
        <bt:String id="XoaMucDo.Tip" DefaultValue="Dành cho: đề có mã ID [2D1-k]. Mở khung bên phải: xoá câu mức 1–4, mã ID, hướng suy luận; thay lời giải bằng dòng chấm; tạo/huỷ khung câu (khung chỉ trên Word desktop)."/>
      </bt:LongStrings>
